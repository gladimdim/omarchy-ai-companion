[Unit]
Description=Omarchy AI Watch Bridge Daemon
After=network.target avahi-daemon.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/omarchy/plugins/gladimdim.omarchy-ai-watch/server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
